<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_things_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Thingsbook 3.0 Bento Header: Glacier Book Brand + Active View Icon + Full View Title + Sky Count Pill + Voice & Sky + Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_header_open_app"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_brand_emblem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_brand_book" />

            <ImageView
                android:id="@+id/widget_view_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="7dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_sun" />

            <TextView
                android:id="@+id/widget_view_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/view_today"
                android:textColor="@color/widget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_things_widget_badge"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textColor="@color/widget_sky_on_tint"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_voice_capture"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_things_widget_plus_btn"
            android:contentDescription="@string/shortcut_voice_capture_short"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic" />

        <ImageView
            android:id="@+id/widget_btn_add_task"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_things_widget_primary_btn"
            android:contentDescription="@string/shortcut_new_todo_short"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_plus" />
    </LinearLayout>

    <!-- Thingsbook 3.0 Soft Bento Icon Switcher Dock (Zero Truncation Across All 5 Languages) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="9dp"
        android:background="@drawable/bg_things_widget_tab_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        android:weightSum="6">

        <ImageView
            android:id="@+id/widget_tab_today"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_things_widget_tab_active"
            android:contentDescription="@string/view_today"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_sun" />

        <ImageView
            android:id="@+id/widget_tab_inbox"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_things_widget_tab_inactive"
            android:contentDescription="@string/view_inbox"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_inbox" />

        <ImageView
            android:id="@+id/widget_tab_upcoming"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_things_widget_tab_inactive"
            android:contentDescription="@string/view_upcoming"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_calendar" />

        <ImageView
            android:id="@+id/widget_tab_anytime"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_things_widget_tab_inactive"
            android:contentDescription="@string/view_anytime"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_compass" />

        <ImageView
            android:id="@+id/widget_tab_someday"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_things_widget_tab_inactive"
            android:contentDescription="@string/view_someday"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_cloud" />

        <ImageView
            android:id="@+id/widget_tab_project"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_things_widget_tab_inactive"
            android:contentDescription="@string/widget_pin_project_tab"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_folder" />
    </LinearLayout>

    <!-- Scrollable Bento Task List + Calm Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_task_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="4dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/empty_view"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp" />
    </FrameLayout>

</LinearLayout>
