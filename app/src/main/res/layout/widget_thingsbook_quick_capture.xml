<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qc_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_things_widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <!-- Thingsbook 3.0 Today Bento Pill (Glacier Book + Warm Sun + Today + Sky Count Capsule) -->
    <LinearLayout
        android:id="@+id/qc_btn_today"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:background="@drawable/bg_things_widget_tab_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="9dp"
        android:paddingRight="9dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_brand_book" />

        <ImageView
            android:id="@+id/qc_icon_today"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_sun" />

        <TextView
            android:id="@+id/qc_label_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/view_today"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qc_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_things_widget_badge"
            android:paddingLeft="7dp"
            android:paddingTop="1.5dp"
            android:paddingRight="7dp"
            android:paddingBottom="1.5dp"
            android:text="0"
            android:textColor="@color/widget_sky_on_tint"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search / Quick Find Bento Squircle -->
    <ImageView
        android:id="@+id/qc_btn_search"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_things_widget_tab_bar"
        android:contentDescription="@string/shortcut_quick_find_short"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_search" />

    <!-- Voice Capture Sky Bento Squircle -->
    <ImageView
        android:id="@+id/qc_btn_voice"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_things_widget_plus_btn"
        android:contentDescription="@string/shortcut_voice_capture_short"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_mic" />

    <!-- Expressive Sky Light Blue (+ New To-Do) Button -->
    <TextView
        android:id="@+id/qc_btn_new_todo"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_things_widget_primary_btn"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:text="@string/shortcut_new_todo_short"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
